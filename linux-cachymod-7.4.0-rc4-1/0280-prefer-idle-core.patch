diff -uNarp a/kernel/sched/fair.c b/kernel/sched/fair.c
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -2351,6 +2351,25 @@ update_stats_curr_start(struct cfs_rq *c
 	se->exec_start = rq_clock_task(rq_of(cfs_rq));
 }
 
+#include "idlecore.h"
+
+/*
+ * Check sched_smt_active before calling this to avoid overheads in fastpaths.
+ * Unlike is_core_idle()—which skips @cpu assuming the caller already verified
+ * it is idle—this checks all SMT siblings including @cpu itself using
+ * available_idle_cpu() (accounting for vCPU preemption).
+ */
+static inline bool is_idle_core(int cpu)
+{
+	int sibling;
+
+	for_each_cpu(sibling, cpu_smt_mask(cpu))
+		if (!available_idle_cpu(sibling))
+			return false;
+
+	return true;
+}
+
 /* Check sched_smt_active before calling this to avoid overheads in fastpaths */
 static inline bool is_core_idle(int cpu)
 {
@@ -9980,8 +9999,20 @@ select_task_rq_fair(struct task_struct *
 	}
 
 	/* Fast path */
-	if (wake_flags & WF_TTWU)
+	if (wake_flags & WF_TTWU) {
+		/*
+		 * If the previous smt-CPU is an idle core and allowed by the
+		 * task's affinity mask, retain it for cache locality.
+		 */
+		if (sched_smt_active() && sched_idlecore_active() &&
+		    cpumask_test_cpu(prev_cpu, p->cpus_ptr) &&
+		    is_idle_core(prev_cpu)) {
+
+			return prev_cpu;
+		}
+
 		return select_idle_sibling(p, prev_cpu, new_cpu);
+	}
 
 	return new_cpu;
 }
@@ -13569,9 +13600,22 @@ asym_active_balance(struct lb_env *env)
 	 * the lower priority @env::dst_cpu help it. Do not follow
 	 * CPU priority.
 	 */
-	return env->idle && sched_use_asym_prio(env->sd, env->dst_cpu) &&
-	       (sched_asym_prefer(env->dst_cpu, env->src_cpu) ||
-		!sched_use_asym_prio(env->sd, env->src_cpu));
+	if (env->idle && sched_use_asym_prio(env->sd, env->dst_cpu) &&
+	    (sched_asym_prefer(env->dst_cpu, env->src_cpu) ||
+	    !sched_use_asym_prio(env->sd, env->src_cpu))) {
+
+		/*
+		 * When idle-core preference is enabled on SMT systems, require
+		 * the destination physical core (all SMT siblings) to be
+		 * completely idle before performing an asymmetric active pull.
+		 */
+		if (sched_smt_active() && sched_idlecore_active())
+			return is_idle_core(env->dst_cpu);
+
+		return true;
+	}
+
+	return false;
 }
 
 static inline bool
diff -uNarp a/kernel/sched/idlecore.c b/kernel/sched/idlecore.c
--- a/kernel/sched/idlecore.c
+++ b/kernel/sched/idlecore.c
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/*
+ * Prefer idle-core scheduling implementation:
+ */
+
+#include <linux/sysctl.h>
+#include "idlecore.h"
+
+DEFINE_STATIC_KEY_FALSE(sched_idlecore_enabled);
+
+#ifdef CONFIG_SYSCTL
+static const struct ctl_table sched_idlecore_sysctls[] = {
+	{
+		.procname	= "sched_idlecore_enabled",
+		.data		= &sched_idlecore_enabled.key,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_do_static_key,
+	},
+};
+
+static int __init sched_idlecore_sysctl_init(void)
+{
+	register_sysctl_init("kernel", sched_idlecore_sysctls);
+	return 0;
+}
+late_initcall(sched_idlecore_sysctl_init);
+
+#endif /* CONFIG_SYSCTL */
diff -uNarp a/kernel/sched/idlecore.h b/kernel/sched/idlecore.h
--- a/kernel/sched/idlecore.h
+++ b/kernel/sched/idlecore.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KERNEL_SCHED_IDLECORE_H
+#define _KERNEL_SCHED_IDLECORE_H
+
+#include <linux/jump_label.h>
+
+DECLARE_STATIC_KEY_FALSE(sched_idlecore_enabled);
+
+static inline bool sched_idlecore_active(void)
+{
+	return static_branch_unlikely(&sched_idlecore_enabled);
+}
+
+#endif /* _KERNEL_SCHED_IDLECORE_H */
